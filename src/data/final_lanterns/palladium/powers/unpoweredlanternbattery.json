        "bluelantern":{
            "type": "palladium:command",
            "icon": "final_lanterns:bluelanternbattery",
            "title": "Blue Lantern Battery",
            "bar_color": "light_gray",
            "hidden": false,
            "hidden_in_bar": true,
            "list_index": -1,
            "gui_position": "null",
            "description": "Speak the Blue Lanterns Oath and Drain your Ring to charge this Battery",
            "first_tick_commands": [
                "tellraw @s [\"\",{\"text\":\"In fearful day,\",\"color\":\"blue\",\"bold\":true}]",
                "tellraw @s [\"\",{\"text\":\"In raging night,\",\"color\":\"blue\",\"bold\":true}]",
                "tellraw @s [\"\",{\"text\":\"with strong hearts full our Souls Ignite.\",\"color\":\"blue\",\"bold\":true}]",
                "tellraw @s [\"\",{\"text\":\"Look to the stars for..\",\"color\":\"blue\",\"bold\":true}]",
                "tellraw @s [\"\",{\"text\":\"Hope Burns Bright!\",\"color\":\"blue\",\"bold\":true}]"
            ],
            "last_tick_commands": [
                "execute at @s run energybar value subtract @s final_lanterns:bluelantern hope 20000",
                "give @s kubejs:bluelanternbattery",
                "clear @s kubejs:lanternbatteryunpowered 1"
            ],
            "commands": [
            ],
            "conditions": {
                "enabling":[
                    {
                        "type": "palladium:action",
                        "cooldown": 25,
                        "key_type": "right_click",
                        "needs_empty_hand": false,
                        "allow_scrolling_when_crouching": true
                    },
                    {
                        "type": "palladium:energy_bar",
                        "power": "final_lanterns:bluelantern",
                        "energy_bar": "hope",
                        "min": 4000,
                        "max": 4000
                    }
                ],
                "unlocking":                     
                {
                    "type": "palladium:has_power",
                    "power": "final_lanterns:bluelantern"
                }
            }
        },
